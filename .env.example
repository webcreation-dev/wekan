# Base de données (SQLite en développement)
DATABASE_URL="file:./dev.db"

# Compte agent créé par `npm run db:seed` (pour l'API agent / l'admin)
AGENT_PHONE="0100000000"
AGENT_PASSWORD="change-moi"

# Paiement Mobile Money : "simulation" (aucun argent ne bouge, validation
# automatique après quelques secondes) tant qu'aucun prestataire n'est branché.
PAYMENT_PROVIDER="simulation"
