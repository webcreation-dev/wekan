# Base de données SQLite locale (développement)
DATABASE_URL="file:./dev.db"

# En ligne (Vercel) : base SQLite hébergée chez Turso. Laisser vide en local.
# Les tables sont créées automatiquement au déploiement (npm run vercel-build).
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Compte agent créé par `npm run db:seed` (pour l'API agent / l'admin)
AGENT_PHONE="0100000000"
AGENT_PASSWORD="change-moi"

# Paiement Mobile Money : "simulation" (aucun argent ne bouge, validation
# automatique après quelques secondes) tant qu'aucun prestataire n'est branché.
PAYMENT_PROVIDER="simulation"

# Vercel Blob (store privé) pour les vocaux : ajoutées par Vercel quand le store
# est relié au projet. Laisser vide en local : les vocaux vont dans storage/voices.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
